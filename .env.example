# OpenAI Compatible API（DeepSeek / 阿里云百炼 / OpenAI 等都走这一套）
# 不要把真实 Key 提交到 Git。复制本文件为 .env 后再填写。

# 例如 DeepSeek：
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 例如阿里云百炼：
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# V25 Embedding（和 Chat 不是同一个模型）
# 例如阿里云百炼：
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# V29 PostgreSQL Checkpointer（不是 pgvector，也不是业务 Conversation 表）
# 本地示例：先建数据库，再填连接串，然后跑 pnpm v29-setup
# POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/langgraph_learn
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/langgraph_learn

# V33 LangSmith Observability（不要把真实 Key 提交到 Git）
# 到 https://smith.langchain.com 创建 API Key
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_PROJECT=agent-framework-learning
# 可选：非美国区再设 LANGSMITH_ENDPOINT
